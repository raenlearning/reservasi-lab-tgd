# ---------------------------------------------------------------------------
# Firebase — RAHASIA. Jangan pernah di-commit.
# ---------------------------------------------------------------------------

# Kunci service account untuk skrip seed & Cloud Functions lokal.
**/serviceAccountKey.json
**/service-account*.json

# Konfigurasi project Firebase untuk aplikasi Android.
# Dihasilkan oleh `flutterfire configure`; setiap developer membuatnya sendiri.
android/app/google-services.json

# Berkas .env bila nanti dipakai untuk konfigurasi lokal.
.env
.env.*

